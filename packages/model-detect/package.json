{
  "name": "@jingoz/pi-model-detect",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi command to enrich existing model capabilities, limits and prices from models.dev with confirmed backup writes",
  "keywords": ["pi", "pi-package", "models", "models.dev"],
  "license": "MIT",
  "files": ["src", "CONTEXT.md", "LICENSE", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffery-zhang/pi-plugins.git",
    "directory": "packages/model-detect"
  },
  "homepage": "https://github.com/jeffery-zhang/pi-plugins/tree/main/packages/model-detect",
  "bugs": { "url": "https://github.com/jeffery-zhang/pi-plugins/issues" },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/host.test.ts",
    "test:package": "npm publish --dry-run --ignore-scripts --offline --json --registry=http://127.0.0.1:1",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run test:package"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*" },
  "dependencies": { "jsonc-parser": "^3.3.1" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "26.3.0",
    "typescript": "^5.9.3"
  }
}
